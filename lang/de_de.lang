# --- Einstellungen ---
media_srcset_settings_title = Einstellungen
media_srcset_settings_intro = Einstellungen für die automatische Platzhalterersetzung im gerenderten HTML.
media_srcset_settings_output_filter = HTML-Platzhalter srcset="rex_media_type=Profil" automatisch ersetzen
media_srcset_settings_output_filter_notice = Dieser Weg stammt aus früheren Versionen und durchsucht jede Seitenausgabe per regulärem Ausdruck nach Platzhaltern. Wer ausschließlich die PHP-API (rex_media_srcset::getImgTag() bzw. ResponsiveImage) nutzt, kann ihn abschalten und spart die Suche bei jedem Seitenaufruf. Die Änderung greift ab dem nächsten Seitenaufruf.
media_srcset_settings_save = Einstellungen speichern
media_srcset_settings_saved = Einstellungen gespeichert.

media_srcset_intro = Virtuelle Bild-Presets für responsive srcset-Ausgaben. Jedes Preset kann mit beliebiger Zielbreite als Media-Manager-Typ "is_[preset]__[breite]" angefragt werden, ohne dass dafür ein eigener Typ in der Medienverwaltung angelegt werden muss.
